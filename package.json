{
  "name": "build-muhely",
  "version": "0.1.0",
  "description": "Grafikus, helyi APK- és EXE-készítő műhely — fiók, várólista és fizetős letöltés nélkül.",
  "main": "electron/main.cjs",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"vite\" \"node server/index.mjs\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "electron:dev": "concurrently -k \"node server/index.mjs\" \"vite\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "electron:build": "npm run build && electron-builder",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@electron/packager": "^18.3.6",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "hu.buildmuhely.app",
    "productName": "BuildMűhely",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "samples/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
