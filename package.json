{
  "name": "creaft",
  "version": "0.3.0",
  "description": "Creaft — grafikus, helyi APK- és EXE-készítő asztali app, reklámmentesen. Creative + Craft.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "concurrently -k \"vite\" \"node server/index.mjs\"",
    "vite:dev": "vite",
    "build": "tsc -b && vite build",
    "build:runner": "esbuild scripts/build-runner-entry.mjs --bundle --platform=node --format=esm --outfile=scripts/build-runner.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start": "node server/index.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:build": "tauri build",
    "test": "node --test tests/*.test.mjs",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "adm-zip": "^0.5.16",
    "cross-spawn": "^7.0.6",
    "express": "^4.21.2",
    "multer": "^2.0.1",
    "tree-kill": "^1.2.2",
    "uuid": "^11.0.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.25.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
