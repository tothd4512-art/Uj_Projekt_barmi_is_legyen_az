{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BuildMűhely",
  "version": "0.2.0",
  "identifier": "hu.buildmuhely.app",
  "build": {
    "beforeDevCommand": "npm run build:runner && npm run vite:dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build && npm run build:runner",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BuildMűhely",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../scripts/build-runner.mjs": "scripts/build-runner.mjs"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
